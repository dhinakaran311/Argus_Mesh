# =============================================================================
# AbuseRing Sentinel — .gitignore
# =============================================================================

# Environment / Secrets
.env
.env.local
.env.production
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-log.txt
pip-delete-this-directory.txt
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# ML Artifacts (large files — stored in Supabase Storage)
ml/models/*.pkl
ml/models/*.joblib
ml/models/*.json
ml/models/*.ubj
!ml/models/.gitkeep

# Data (raw CSVs — too large for git)
data/raw/*.csv
data/processed/*.csv
!data/raw/.gitkeep
!data/processed/.gitkeep

# Keep sample data in git (small)
!data/sample/*.csv

# Generation artifacts
data/raw/generation_summary.json

# Node / Frontend
node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/
frontend/dist/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js
.next/
out/

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Render / Vercel
.vercel/

# Docker
docker-compose.override.yml

# OS
.DS_Store
.AppleDouble
.LSOverride
