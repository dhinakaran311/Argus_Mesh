# =============================================================================
# AbuseRing Sentinel — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (RESERVED — not currently active; DataStore uses CSV files)
# These will be used once the real-Supabase migration is complete.
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co/rest/v1/
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Qdrant Cloud (Vector Database — case memory for RAG)
# -----------------------------------------------------------------------------
QDRANT_URL=https://your-cluster.us-east-1-1.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION_NAME=argus-mesh-vectors

# -----------------------------------------------------------------------------
# Neo4j Aura (Graph Database — ring detection)
# -----------------------------------------------------------------------------
NEO4J_URI=neo4j+s://your-neo4j-id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# -----------------------------------------------------------------------------
# Groq API (LLM — investigation report generation)
# Run `curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"`
# to list available models for your account tier.
# -----------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=compound-beta
GROQ_FAST_MODEL=compound-beta-mini

# -----------------------------------------------------------------------------
# HuggingFace Inference API (Embeddings — RAG similarity search)
# -----------------------------------------------------------------------------
HUGGINGFACE_API_KEY=hf_your_huggingface_api_key
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
# BACKEND_URL: Must be set to your deployed backend URL in production.
# Used by the Next.js frontend proxy (next.config.ts) to route /api/* calls.
# Example: https://your-backend.onrender.com
# Defaults to http://localhost:8000 in local dev if not set.
BACKEND_URL=http://localhost:8000

# SECRET_KEY: Shared secret for X-API-Key authentication on paid endpoints
# (/api/investigate, /api/rag/*). Pass as header: X-API-Key: <value>.
# Set a long random string in production. Leave as "changeme" to skip auth
# in local dev (NOT safe for production).
SECRET_KEY=changeme

ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# -----------------------------------------------------------------------------
# ML Settings
# -----------------------------------------------------------------------------
RISK_THRESHOLD=0.1
FP_COST_INR=100
FN_COST_INR=3000
MODEL_VERSION=v1

# -----------------------------------------------------------------------------
# Data Paths (relative to project root — usually no need to change)
# -----------------------------------------------------------------------------
DATA_RAW_PATH=data/raw
DATA_PROCESSED_PATH=data/processed
