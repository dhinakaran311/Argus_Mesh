# =============================================================================
# AbuseRing Sentinel — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (PostgreSQL + Storage)
# Get from: https://supabase.com/dashboard/project/<your-project>/settings/api
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Qdrant Cloud (Vector Database)
# Get from: https://cloud.qdrant.io/
# -----------------------------------------------------------------------------
QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION_NAME=abuse_cases

# -----------------------------------------------------------------------------
# Neo4j Aura (Graph Database)
# Get from: https://console.neo4j.io/
# -----------------------------------------------------------------------------
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password

# -----------------------------------------------------------------------------
# Groq API (LLM — llama-3.3-70b-versatile)
# Get from: https://console.groq.com/keys
# -----------------------------------------------------------------------------
GROQ_API_KEY=gsk_your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama3-8b-8192

# -----------------------------------------------------------------------------
# HuggingFace Inference API (Embeddings)
# Get from: https://huggingface.co/settings/tokens
# -----------------------------------------------------------------------------
HUGGINGFACE_API_KEY=hf_your-huggingface-token
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
BACKEND_URL=http://localhost:8000
SECRET_KEY=your-random-secret-key-min-32-chars
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# -----------------------------------------------------------------------------
# Frontend (Next.js)
# Prefix with NEXT_PUBLIC_ to expose to the browser
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=AbuseRing Sentinel

# -----------------------------------------------------------------------------
# ML Configuration
# -----------------------------------------------------------------------------
MODEL_VERSION=v1
MODEL_ARTIFACT_PATH=models/xgboost_v1.pkl
RISK_THRESHOLD=0.68
FP_COST_INR=100
FN_COST_INR=3000

# -----------------------------------------------------------------------------
# Data Paths (for local scripts / Colab)
# -----------------------------------------------------------------------------
DATA_RAW_PATH=data/raw
DATA_PROCESSED_PATH=data/processed
DATA_SAMPLE_PATH=data/sample
